# DOCEASE Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for server-managed sessions
JWT_SECRET=your_secure_random_jwt_secret_change_in_production_32chars

# Database location
DATABASE_FILE=./data/docease.db

# Private Vault Storage Directory
VAULT_STORAGE_PATH=./data/vault_storage

# SMS / Email OTP Gateway Configuration
# Optional: If not provided, OTP is generated securely on server and logged for development mode
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Maps API Key (Optional: Address fallback used if not configured)
GOOGLE_MAPS_API_KEY=
